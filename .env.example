# Copy to .env for local development. Never commit real keys.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Optional: marks orders paid via webhook if the customer closes the tab mid-payment
STRIPE_WEBHOOK_SECRET=whsec_...
# Creates the first admin on an empty production database
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Menu photo uploads: Supabase project URL and secret (service role) key. Server-only.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=
